# Bun/Hono API (scaffold only — no routes are enabled yet)
API_PORT=8787

# Redis: cache pages and short-lived viewer/session metadata only. Do not store
# case artifacts here.
REDIS_URL=redis://localhost:6379
EVIDENCE_CACHE_TTL_SECONDS=300

# S3-compatible object storage. MinIO values below match compose.yaml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=trace-evidence
S3_ACCESS_KEY=trace-local
S3_SECRET_KEY=replace-before-deploying
S3_FORCE_PATH_STYLE=true

# WebShark owns PCAP analysis. It is exposed locally at this origin.
WEBSHARK_URL=http://localhost:8085/webshark/
