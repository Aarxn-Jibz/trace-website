# Bun/Hono API (scaffold only — no routes are enabled yet)
API_PORT=8787

# Future external Redis: cache pages and short-lived viewer/session metadata
# only. Do not store case artifacts here.
REDIS_URL=redis://localhost:6379
EVIDENCE_CACHE_TTL_SECONDS=300

# Server-local evidence roots for each released case. May be absolute or
# relative to the repository. Defaults to the case folders in the repo.
# CASE_01_ROOT=CASE_01_Beginner
# CASE_02_ROOT=CASE_02_Medium
# CASE_03_ROOT=CASE_03_Hard

# WebShark owns PCAP analysis. It is exposed locally at this origin.
WEBSHARK_URL=http://localhost:8085/webshark/
