FROM oven/bun:latest

WORKDIR /app

COPY backend/package.json ./
RUN bun install --production

COPY backend ./backend
COPY CASE_01_Beginner ./CASE_01_Beginner
COPY CASE_02_Medium ./CASE_02_Medium
COPY CASE_03_Hard ./CASE_03_Hard
COPY CASE_05_SILENT_BEACON ./CASE_05_SILENT_BEACON

ENV PORT=8787
ENV API_PORT=8787

EXPOSE 8787

CMD ["bun", "backend/src/index.ts"]
